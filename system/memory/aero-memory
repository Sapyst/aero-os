    ja_prot = [p for p in procs if (p.vital or p.user_protect) and p.adj is not None and p.adj <= PROTECT_ADJ]
    nao_conf = [p for p in procs if comm_matches(p.comm, VITAL) and p.exe_ok is None and not p.aero]
    print(f"  Protected    {len(ja_prot)} already, would protect {len(prot)} more: {names_summary(prot)}")
    if nao_conf:
        print(f"               {len(nao_conf)} desktop processes can't be verified without root: {names_summary(nao_conf)}")
    print(f"  First to go  would mark {len(pref)}: {names_summary(pref)}")
    if pausar:
        print(f"  On warning   would pause {len(pausar)} ({names_summary(pausar)}, {mib(sum(p.mem for p in pausar))} MB)")
    else:
        print("  On warning   nothing to pause right now")
    if vitima is not None:
        g = kill_group(vitima, procs)
        extra = f" + {len(g) - 1} more like it" if len(g) > 1 else ""
        print(f"  If critical  would close {sanitize_name(vitima.comm)} ({vitima.pid}{extra}, "
              f"{mib(sum(p.mem for p in g))} MB, oom_score {vitima.score})")
    else:
        print("  If critical  no app worth closing right now")
    estado = None
    try:
        estado = json.loads(read_path(os.path.join(run_dir, "state.json"), MAX_JSON_FILE))
    except (OSError, ValueError):
        pass
    if isinstance(estado, dict) and type(estado.get("t")) is int:
        idade = int(time.time()) - estado["t"]
        pausados = estado.get("paused_count")
        print(f"  Service      level {sanitize_name(estado.get('level', '?'), 10)}, updated {idade} s ago, "
              f"{pausados if type(pausados) is int else 0} processes paused by it")
    else:
        print("  Service      not running (no state file)")
    if not root:
        print("  Note         not running as root: other users' processes show less detail")
    return 0


def names_summary(procs, maximo=8):
    nomes = {}
    for p in procs:
        n = sanitize_name(p.comm)
        nomes[n] = nomes.get(n, 0) + 1
    partes = [f"{n}×{c}" if c > 1 else n for n, c in sorted(nomes.items())]
    return (", ".join(partes[:maximo]) + (f" +{len(partes) - maximo}" if len(partes) > maximo else "")) or "-"


def run_resume_paused(run_dir, proc_root=PROC):
    """ExecStopPost: retoma o que estiver anotado e desfaz o oom_score_adj que adj.json lista (rede de
    segurança se o daemon morreu sem limpar: SIGKILL no fim do prazo, watchdog, queda). Numa parada
    limpa o próprio guarda já desfez tudo e os arquivos nem existem."""
    if not os.path.isdir(run_dir):
        return 0            # nada anotado (o serviço nem chegou a criar a pasta)
    st = Store(run_dir, criar=False)
    try:
        registros = st.load_paused()
        n, ficaram = 0, []
        for reg in registros:
            try:
                fd = open_verified(reg["pid"], reg["start"], False)
            except OSError:
                ficaram.append(reg)
                continue
            if fd is None:
                continue
            try:
                n += send(fd, signal.SIGCONT)
            except OSError:
                ficaram.append(reg)
            finally:
                os.close(fd)
        st.save_paused(ficaram)
        if registros:
            log(5, f"resumed {n} of {len(registros)} processes left paused")
        undo_adj_file(st, proc_root)
    finally:
        st.close()
    return 0


def undo_adj_file(st, proc_root=PROC):
    """Devolve o valor original a quem adj.json lista (só se ainda estiver com o valor que o guarda
    pôs) e depois zera o -900 que os apps de pessoas herdaram dos vitais. Devolve (desfeitos, zerados)."""
    applied = st.load_adj()
    if not applied:
        st.remove("adj.json")       # vazio ou estragado
        return 0, 0
    n, ficaram = 0, {}
    for (pid, inicio), (orig, posto) in applied.items():
        if orig == posto:
            continue
        try:
            n += write_adj(pid, inicio, orig, proc_root, esperado=posto)
        except OSError:
            ficaram[(pid, inicio)] = (orig, posto)      # tenta de novo no próximo guarda
    zerados = 0
    procs = Scanner(proc_root).scan(dict(DEFAULTS), details=False)
    orig_adj = {k: v[0] for k, v in applied.items()}
    for p, valor, _ in plan_protection(procs, orig_adj, set(), restaurando=True):
        try:
            zerados += write_adj(p.pid, p.start, valor, proc_root, esperado=PROTECT_ADJ)
        except OSError:
            pass
    st.save_adj(ficaram)
    if n or zerados:
        log(5, f"protection undone: {n} processes back to their own priority, {zerados} apps reset")
    return n, zerados


def main(argv=None):
    global VERBOSE
    import argparse  # noqa: PLC0415
    ap = argparse.ArgumentParser(prog="aero-memory", description="Aero OS memory guard")
    modo = ap.add_mutually_exclusive_group()
    modo.add_argument("--check", action="store_true", help="one-shot report, never acts")
    modo.add_argument("--dry-run", action="store_true", help="run the loop but only log actions")
    modo.add_argument("--resume-paused", action="store_true", help="resume processes left paused, then exit")
    ap.add_argument("--config", default=CONF_PATH, help=f"config file (default {CONF_PATH})")
    ap.add_argument("--run-dir", default=None,
                    help=f"state directory (default {RUN_DIR}; with --dry-run nothing is written unless "
                         f"given, and never into {RUN_DIR})")
    ap.add_argument("--verbose", action="store_true", help="also log debug messages")
    a = ap.parse_args(argv)
    VERBOSE = a.verbose
    if a.check:
        return run_check(a.config, a.run_dir or RUN_DIR)
    if a.resume_paused:
        return run_resume_paused(a.run_dir or RUN_DIR)
    if not a.dry_run and os.geteuid() != 0:
        # sem root o guarda funcionaria pela metade (mexeria só nos processos deste usuário)
        print("aero-memory: the guard runs as root (aero-memory.service); "
              "as a normal user use --check or --dry-run", file=sys.stderr)
        return 2
    if a.dry_run and a.run_dir and os.path.realpath(a.run_dir) == os.path.realpath(RUN_DIR):
        # o agente do usuário e o Settings leem essa pasta: um ensaio lá dentro pareceria de verdade
        print(f"aero-memory: --dry-run can't write into the live {RUN_DIR}; use another --run-dir",
              file=sys.stderr)
        return 2
    run_dir = a.run_dir if a.dry_run else (a.run_dir or RUN_DIR)
    return Guard(a.config, run_dir, dry_run=a.dry_run).run()


if __name__ == "__main__":
    sys.exit(main())
