#version 300 es
// Aero workspace transition (DotStyle): the screen becomes a halftone grid of dots, and a wave sweeps
// across in the direction you move, turning the dots back into the new workspace.
precision highp float;
in vec2 v_texcoord;
uniform sampler2D tex;
out vec4 fragColor;

const float DIR = @DIR@;          // +1 = going right, -1 = left
const float FORCE = @FORCE@;      // 1 at the start of the transition, falling to 0
const float SEED = @SEED@;        // one value per frame (no "time" uniform: keeps damage tracking on)
const vec3 TINT = @TINT@;
const float TINT_AMT = @TINT_AMT@;

void main() {
    vec2 size = vec2(textureSize(tex, 0));
    vec2 px = v_texcoord * size;
    // the side you are moving towards clears first: a soft wave front crossing the screen
    float lado = DIR > 0.0 ? 1.0 - v_texcoord.x : v_texcoord.x;
    float f = clamp(FORCE * 1.7 - lado * 0.7, 0.0, 1.0);
    f = f * f * (3.0 - 2.0 * f);
    vec3 original = texture(tex, v_texcoord).rgb;
    if (f < 0.002) { fragColor = vec4(original, 1.0); return; }
    float cell = 6.0 + 26.0 * f;
    vec2 centro = (floor(px / cell) + 0.5) * cell;
    vec3 c = texture(tex, centro / size).rgb;
    float luz = dot(c, vec3(0.299, 0.587, 0.114));
    // halftone: brighter cell = bigger dot; a floor keeps dark areas as tiny dots (the grid stays visible)
    float raio = cell * 0.5 * (0.18 + 0.78 * sqrt(luz));
    float d = length(px - centro);
    float dentro = 1.0 - smoothstep(raio - 1.0, raio + 1.0, d);
    vec3 ponto = mix(c, TINT * (0.25 + luz), TINT_AMT * f) * dentro;
    fragColor = vec4(mix(original, ponto, f), 1.0);
}
