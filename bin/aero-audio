#!/usr/bin/env python3
"""aero-audio: Aero OS fixed device volume.

Some audio devices (mostly USB headsets) have a volume control of their own that misbehaves:
below 100% it plays one side louder than the other, or it comes back at 0% after reconnecting.
For devices in the list, Aero does the volume in software (PipeWire) and keeps the device's own
volume pinned at 100%, so the system volume is always the real volume.

  aero-audio list              devices with fixed volume
  aero-audio set CARD on|off   add or remove a card (its PipeWire name, alsa_card.…)
  aero-audio apply             write the WirePlumber rule from the list and reload
  aero-audio guard             keep listed devices at 100%, and switch the output to devices as
                               they connect (run by aero-audio-guard.service)
  aero-audio switch on|off     switch the output to a headset/speaker when it connects (like a phone)

The list lives in ~/.config/aero/fixed-volume.list, one card name per line.
Preferences live in ~/.config/aero/audio.conf (switch_to_new=on|off).
"""
import json
import os
import subprocess
import sys
import threading
import time

LIST = os.path.expanduser("~/.config/aero/fixed-volume.list")
RULE = os.path.expanduser("~/.config/wireplumber/wireplumber.conf.d/51-aero-fixed-volume.conf")
SERVICE = "aero-audio-guard.service"
PREFS = os.path.expanduser("~/.config/aero/audio.conf")


def prefs():
    p = {"switch_to_new": "on"}
    try:
        for line in open(PREFS):
            if "=" in line and not line.startswith("#"):
                k, v = line.split("=", 1)
                p[k.strip()] = v.strip()
    except FileNotFoundError:
        pass
    return p


def save_prefs(p):
    os.makedirs(os.path.dirname(PREFS), exist_ok=True)
    with open(PREFS, "w") as f:
        f.write("# Aero OS sound (written by aero-audio and Settings)\n")
        f.writelines(f"{k}={v}\n" for k, v in p.items())


def run(cmd):
    return subprocess.run(cmd, capture_output=True, text=True)


def listed():
    try:
        with open(LIST) as f:
            return [l.strip() for l in f if l.strip() and not l.startswith("#")]
    except FileNotFoundError:
        return []


def save(names):
    os.makedirs(os.path.dirname(LIST), exist_ok=True)
    with open(LIST, "w") as f:
        f.write("# Aero OS: devices whose own volume stays at 100% (volume done in software).\n")
        f.write("".join(n + "\n" for n in sorted(set(names))))


def write_rule(names):
    os.makedirs(os.path.dirname(RULE), exist_ok=True)
    if not names:
        if os.path.exists(RULE):
            os.remove(RULE)
        return
    matches = ", ".join('{ device.name = "%s" }' % n for n in names)
    with open(RULE, "w") as f:
        f.write("# Written by aero-audio from ~/.config/aero/fixed-volume.list. Don't edit by hand.\n")
        f.write("# These devices get their volume in software; their own mixer is kept at 100%.\n")
        f.write("monitor.alsa.rules = [\n  {\n    matches = [ %s ]\n" % matches)
        f.write("    actions = { update-props = { api.alsa.soft-mixer = true } }\n  }\n]\n")


def cards():
    """PipeWire card name -> ALSA card number, for cards present now."""
    r = run(["pactl", "-f", "json", "list", "cards"])
    if r.returncode != 0:
        return {}
    out = {}
    for c in json.loads(r.stdout):
        n = c.get("properties", {}).get("api.alsa.card")
        if n is not None:
            out[c["name"]] = str(n)
    return out


def playback_controls(card):
    """Simple mixer controls of a card that have a playback volume or switch."""
    r = run(["amixer", "-c", card])
    controls, name = [], None
    for line in r.stdout.splitlines():
        if line.startswith("Simple mixer control "):
            name = line[len("Simple mixer control "):]
        elif name and line.strip().startswith("Capabilities:") and ("pvolume" in line or "pswitch" in line):
            controls.append(name)
            name = None
    return controls


def pin(card):
    for c in playback_controls(card):
        run(["amixer", "-q", "-c", card, "sset", c, "100%", "unmute"])


def watch(name, card, stop):
    """Pins the card now and again after every change to its playback volume; ends when the card goes."""
    pin(card)
    p = subprocess.Popen(["stdbuf", "-oL", "alsactl", "monitor", "hw:" + card], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    for line in p.stdout:
        if stop.is_set():
            break
        if "Playback Volume" in line or "Playback Switch" in line:
            pin(card)
    p.kill()


# ---------- trocar a saída para o aparelho que acabou de conectar (como no celular) ----------
# Vale para fones e caixas USB e Bluetooth. Fica de fora: HDMI (o monitor "reconecta" toda vez que
# acorda), microfones USB que também têm saída (fifine) e webcams. Só a SAÍDA muda: trocar o
# microfone para um fone Bluetooth derruba a qualidade do som dele (perfil de chamada).

def sinks():
    r = run(["pactl", "-f", "json", "list", "sinks"])
    return {s["name"]: s for s in json.loads(r.stdout)} if r.returncode == 0 else {}


def is_personal(sink):
    p = sink.get("properties", {})
    return p.get("device.bus") in ("usb", "bluetooth") and p.get("device.form_factor") not in ("microphone", "webcam")


def audio_age():
    """Seconds since PipeWire's session manager (re)started: right after it, every device 'appears'."""
    r = run(["systemctl", "--user", "show", "wireplumber.service", "-p", "ActiveEnterTimestampMonotonic", "--value"])
    try:
        return time.monotonic() - int(r.stdout.strip()) / 1e6
    except ValueError:
        return 999.0


def switcher():
    known = set(sinks())
    p = subprocess.Popen(["pactl", "subscribe"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    for line in p.stdout:
        if "'new' on sink" not in line and "'remove' on sink" not in line:
            continue
        time.sleep(0.8)  # deixa o aparelho terminar de aparecer (nome, perfil)
        now = sinks()
        new = [n for n in now if n not in known]
        known = set(now)
        if not new or prefs().get("switch_to_new") != "on" or audio_age() < 8 or len(new) > 2:
            continue
        for name in new:
            if is_personal(now[name]):
                run(["pactl", "set-default-sink", name])
                desc = now[name].get("description", name)
                run(["notify-send", "-a", "Sound", "-i", "audio-headphones", "Sound output", desc])
                break
    p.kill()


def guard():
    def keep_switching():
        while True:          # se o PipeWire reiniciar, o pactl subscribe cai: começa de novo
            switcher()
            time.sleep(2)
    threading.Thread(target=keep_switching, daemon=True).start()
    running = {}  # card name -> (alsa number, thread, stop flag)
    while True:
        want = set(listed())
        now = cards()
        for name in want:
            card = now.get(name)
            t = running.get(name)
            if card and (not t or not t[1].is_alive() or t[0] != card):
                stop = threading.Event()
                th = threading.Thread(target=watch, args=(name, card, stop), daemon=True)
                th.start()
                running[name] = (card, th, stop)
        for name in list(running):
            if name not in want:
                running[name][2].set()
                del running[name]
        time.sleep(2)


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__)
    elif args[0] == "list":
        print("\n".join(listed()))
    elif args[0] == "set" and len(args) == 3:
        names = [n for n in listed() if n != args[1]]
        if args[2] == "on":
            names.append(args[1])
        save(names)
        main_apply()
    elif args[0] == "apply":
        main_apply()
    elif args[0] == "guard":
        guard()
    elif args[0] == "switch" and len(args) == 2 and args[1] in ("on", "off"):
        p = prefs()
        p["switch_to_new"] = args[1]
        save_prefs(p)
    else:
        print(__doc__)
        sys.exit(2)


def main_apply():
    write_rule(listed())
    run(["systemctl", "--user", "restart", "wireplumber.service"])
    run(["systemctl", "--user", "restart", SERVICE])


if __name__ == "__main__":
    main()
