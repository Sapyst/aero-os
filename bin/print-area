#!/usr/bin/env bash
# print-area — print de uma área escolhida com o mouse (igual Win+Shift+S).
# Arraste um retângulo; ao soltar, o print vai pra área de transferência
# e é salvo em ~/Pictures/Prints. Esc cancela.
#
# Uso: print-area            (escolhe a área com o mouse)        Print e Super+Shift+S
#      print-area tela       (a tela inteira)                     Shift+Print
#      print-area janela     (só a janela ativa, mesmo coberta)   Alt+Print
#      print-area "X,Y LxA"  (área já definida, ex: "100,100 400x300")

# Pasta de imagens do usuário (xdg-user-dir respeita o nome configurado, ex: "Imagens")
pasta="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Prints"
mkdir -p "$pasta"

arquivo="$pasta/screenshot-$(date +%Y-%m-%d_%H-%M-%S).png"   # hora do APERTO, não da seleção

modo=area
if [ "$1" = tela ]; then
    modo=tela
elif [ "$1" = janela ]; then
    modo=janela
elif [ -n "$1" ]; then
    area="$1"
else
    # CONGELA A TELA no instante do Print, em DOIS passos:
    #  1) o grim tira o retrato da tela inteira ANTES de qualquer seleção aparecer. É desse retrato
    #     que o recorte sai — então a borda do slurp, o escurecido e qualquer UI da ferramenta
    #     nunca entram na imagem (antes o grim -g rodava com a camada do slurp ainda na tela).
    #  2) o hyprpicker mostra a tela parada por cima de tudo (vídeos/jogos param) enquanto você seleciona.
    #     -r = congela também os outros monitores | -z = sem a lupa de cor (ele é um conta-gotas)
    congelado="${XDG_RUNTIME_DIR:-/tmp}/print-area-$$.ppm"   # PPM: grava instantâneo, sem compressão
    grim -t ppm "$congelado" || { notify-send "Screenshot failed" "Could not capture the screen"; exit 1; }
    hyprpicker -r -z >/dev/null 2>&1 &
    congela=$!
    trap 'kill $congela 2>/dev/null; rm -f "$congelado"' EXIT   # descongela e limpa ao sair (até com Esc)
    sleep 0.15                               # tempo do retrato aparecer na tela

    # slurp: desenha a seleção e devolve "X,Y LARGURAxALTURA" (coordenadas lógicas do Hyprland)
    #   -d = mostra o tamanho enquanto arrasta
    #   -b = cor do fundo escurecido | -c = cor da borda | -w = espessura da borda
    # cor da borda = a cor de destaque do sistema (Settings → Appearance → Accent color)
    destaque=$(cat "$HOME/.cache/hypr-tema/destaque" 2>/dev/null); destaque=${destaque:-3584e4}
    area=$(slurp -d -b 00000066 -c "${destaque}ff" -w 2) || exit 0   # Esc: slurp sai com erro, então cancela
    modo=recorte
fi

# Recorta a área (lógica) de dentro do retrato congelado. O grim junta todos os monitores numa imagem
# na MAIOR escala; então: pixel = (coordenada lógica − canto do layout) × (largura da imagem ÷ largura lógica).
recortar() {
    python3 -I - "$congelado" "$area" "$arquivo" <<'PY'
import json, re, subprocess, sys
src, area, dst = sys.argv[1:4]
x, y, w, h = map(int, re.match(r"(-?\d+),(-?\d+) (\d+)x(\d+)", area).groups())
mons = json.loads(subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True).stdout)
caixas = []
for m in mons:
    lw, lh = m["width"] / m["scale"], m["height"] / m["scale"]
    if m.get("transform", 0) % 2:      # monitor girado 90/270: troca largura e altura
        lw, lh = lh, lw
    caixas.append((m["x"], m["y"], m["x"] + lw, m["y"] + lh))
x0, y0 = min(c[0] for c in caixas), min(c[1] for c in caixas)
x1 = max(c[2] for c in caixas)
with open(src, "rb") as f:                 # cabeçalho PPM: "P6\n<largura> <altura>\n255\n"
    largura = int(f.readline() and f.readline().split()[0])
k = largura / (x1 - x0)
geo = f"{round(w * k)}x{round(h * k)}+{round((x - x0) * k)}+{round((y - y0) * k)}"
sys.exit(subprocess.run(["magick", src, "-crop", geo, "+repage", dst]).returncode)
PY
}

# grim tira o print (tela/janela); no recorte, a imagem sai do retrato congelado lá de cima.
case $modo in
    tela)    grim "$arquivo" ;;                                   # sem -g = a tela toda
    janela)  id=$(hyprctl activewindow -j | python3 -I -c 'import json,sys; print(json.load(sys.stdin).get("stableId",""))')
             grim -T "$id" "$arquivo" ;;                          # -T = só aquela janela (doc 20)
    recorte) recortar ;;
    *)       grim -g "$area" "$arquivo" ;;                        # área passada pronta no argumento
esac || { notify-send "Screenshot failed" "Could not capture the screen"; exit 1; }

# Emagrece o PNG sem perder a leitura de texto pequeno:
#   pngquant: reduz pra 256 cores bem escolhidas (visualmente igual em UI/texto); --quality 85-98 faz ele
#             DESISTIR (e manter o original) se não conseguir ficar com qualidade alta, ex: fotos
#   oxipng:   recompressão sem perda por cima. Se qualquer um falhar, o print original continua intacto.
tmp="$arquivo.tmp.png"
if pngquant --quality 85-98 --speed 1 --force --output "$tmp" "$arquivo" 2>/dev/null; then
    mv -f "$tmp" "$arquivo"
fi
rm -f "$tmp"
oxipng -o 4 --strip safe -q "$arquivo" 2>/dev/null

# wl-copy coloca a imagem na área de transferência (Ctrl+V cola em qualquer lugar)
wl-copy --type image/png < "$arquivo"

# Notificação com a miniatura do print e um botão "Show in folder" (-A = ação; o notify-send espera a
# resposta, por isso roda em segundo plano com "&": o print não fica preso esperando você clicar)
(
    resposta=$(notify-send -i "$arquivo" -A pasta="Show in folder" \
        "Screenshot copied" "Saved to Prints/$(basename "$arquivo")")
    [ "$resposta" = pasta ] && thunar "$arquivo"
) &
