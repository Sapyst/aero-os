#!/usr/bin/env python3
"""termusic-vol — volume INTERNO do TerMusic/YTMusic (o mpv do motor), sem mexer no volume do sistema.
  termusic-vol          mostra o volume atual
  termusic-vol 40       define 40%
  termusic-vol +5 / -5  sobe / desce 5   (limite 0–130, igual às teclas + - do TerMusic)"""
import json, os, socket, sys

SOCK = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "ytmotor.sock")

def chamar(cmd, **p):
    s = socket.socket(socket.AF_UNIX)
    try:
        s.connect(SOCK)
    except OSError:
        sys.exit("TerMusic is not running")
    with s:
        s.settimeout(5)
        s.sendall((json.dumps({"cmd": cmd, **p}) + "\n").encode())
        buf = b""
        while not buf.endswith(b"\n"):
            parte = s.recv(65536)
            if not parte:
                break
            buf += parte
    return json.loads(buf or b"null")

def volume():
    r = chamar("estado")
    r = (r or {}).get("r")
    return float((r or {}).get("volume") or 0)

arg = sys.argv[1] if len(sys.argv) > 1 else ""
if arg in ("-h", "--help"):
    print(__doc__.split("\n", 1)[1]); sys.exit()
if arg:
    try:
        v = volume() + float(arg) if arg[0] in "+-" else float(arg)
    except ValueError:
        sys.exit("usage: termusic-vol [N | +N | -N]")
    chamar("volume", v=max(0, min(130, v)))
print(f"{round(volume())}%")
