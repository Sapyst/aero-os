#!/usr/bin/env bash
# Histórico da área de transferência (Ctrl+Shift+V).
# Uso: clipboard           abre/fecha a janelinha (~/.local/share/aero-shell/clipboard.py)
#      clipboard --daemon  o vigia do histórico, supervisionado (aero-supervise): o aero-clipd (Rust);
#                          se ele cair 3x em 60 s, ou com clipboard=python em ~/.config/aero/daemons.conf,
#                          o clássico "wl-paste --watch clipboard-guardar"
if [ "$1" = --daemon ]; then
    exec "$HOME/.local/bin/aero-supervise" clipboard Clipboard "$HOME/.local/bin/aero-clipd" \
        "wl-paste --watch $HOME/.local/bin/clipboard-guardar"
fi
# Caminho rápido: pede pelo D-Bus pro programa que já está aberto executar a ação "alternar"
gdbus call --session --dest com.aero.Clipboard --object-path /com/aero/Clipboard \
    --method org.gtk.Actions.Activate alternar '[]' '{}' >/dev/null 2>&1 && exit 0
# Abre a janela sob demanda (sai da memória ao fechar)
# Thumbnails are local files; going through gvfs can hang the window before it opens
export GIO_USE_VFS=local
exec python3 "$HOME/.local/share/aero-shell/clipboard.py" "$@"
