#!/usr/bin/env bash
# hypr-tema — tema claro/escuro, filtro de luz azul e A COR DO TEMA.
# Configuração em ~/.config/hypr/painel.conf (o app Settings edita):
#   TEMA_MODO=auto|claro|escuro      TEMA_CLARO=07:00  TEMA_ESCURO=18:00
#   FILTRO_MODO=auto|ligado|desligado FILTRO_INICIO=19:00 FILTRO_FIM=07:00 FILTRO_TEMP=4500
#   COR_CLARA=f6f6f6  COR_ESCURA=1e1e1e  COR_ALFA=0.80   cor da barra (taskbar) em cada tema
#   BAR_ALPHA=0.45   opacity of the taskbar alone (frosted: Hyprland blurs what is behind it)
#   COR_SINC=1   1 = todo o sistema usa a cor da barra; 0 = só a barra, o resto com as cores padrão
#   COR_DESTAQUE=3584e4   cor de destaque (seleção, interruptores, links): vale sempre, com ou sem sincronia
#   COR_DESTAQUE=mono     destaque MONOCROMÁTICO (doc 42): no escuro quase branco com texto escuro e sombra
#                         preta em volta das linhas; no claro quase preto com texto claro e brilho branco
#
# A cor da barra é a "fonte": daqui saem as cores de
#   barra de cima (waybar) · barras de título (hyprbars) · apps GTK4/libadwaita (Settings, menu...)
#   · notificações (mako)
#
# Uso: hypr-tema           aplica agora (só o que mudou)
#      hypr-tema --forcar  aplica tudo de novo
#      hypr-tema --loop    fica rodando, conferindo a cada minuto (o Hyprland inicia assim);
#                          sai sozinho quando o Hyprland que o iniciou morre (ex: travou)

ESTADO="$HOME/.cache/hypr-tema"
[ -d "$ESTADO" ] || mkdir -p "$ESTADO"
# SEM PROCESSOS À TOA: a troca roda junto com a cascata (as peças do shell animando), e aí cada comando
# externo (cat, cmp, mv, awk, date...) custava ~25 ms só pra nascer — dezenas deles davam ~0,7 s. Por isso
# aqui quase tudo é do próprio bash: read/printf -v/[[ ]] em vez de $(...), cat, cmp e awk.

# "07:30" -> 450 (minutos desde a meia-noite). 10# = ler como decimal ("08" não é octal)
minutos() {   # "HH:MM" -> minutos em $REPLY; qualquer outra coisa vale 0 (vem do painel.conf: nunca vira conta)
    REPLY=0
    [[ $1 =~ ^([0-9]{1,2}):([0-9]{2})$ ]] && REPLY=$((10#${BASH_REMATCH[1]} * 60 + 10#${BASH_REMATCH[2]}))
}

# dentro AGORA INICIO FIM: o horário está no intervalo? (funciona passando da meia-noite)
dentro() {
    local a=$1 i=$2 f=$3
    if (( i <= f )); then (( a >= i && a < f )); else (( a >= i || a < f )); fi
}

# Arquivo gerado só é trocado se o conteúdo MUDOU: quem vigia (Hyprland recarrega sozinho todo .conf
# que ele lê; waybar; apps) não acorda à toa. Uso: gera em "ARQ.novo" e chama trocar ARQ.
# gravar ARQ CONTEÚDO: escreve só se mudou (devolve 0 = mudou, 1 = igual)
gravar() {
    local atual=""
    [ -f "$1" ] && IFS= read -r -d '' atual < "$1"
    [ "$atual" = "$2" ] && return 1
    printf '%s' "$2" > "$1"
}

# "f6f6f6" -> "246,246,246"   (cada par de letras é um número em hexadecimal: f6 = 246)
rgb() { printf -v REPLY "%d,%d,%d" "0x${1:0:2}" "0x${1:2:2}" "0x${1:4:2}"; }
# "0.80" -> "cc"   (opacidade de 0 a 1 vira 00 a ff, o formato que o Hyprland usa)
alfa_hex() {   # sem awk: "0.8" -> 800 milésimos -> round(800 * 255 / 1000)
    local i=0 f=000
    [[ $1 =~ ^([0-9]*)(\.([0-9]*))?$ ]] && { i=${BASH_REMATCH[1]:-0}; f=${BASH_REMATCH[3]}000; f=${f:0:3}; }
    printf -v REPLY "%02x" $(( ((10#$i * 1000 + 10#$f) * 255 + 500) / 1000 ))
}

# Apps GTK3 não leem as --variáveis do libadwaita: o tema Adwaita do GTK3 usa "@define-color".
# Fundo com transparência = o vidro do Hyprland aparece atrás (Thunar com o mesmo branco 80% da barra).
gerar_gtk3() {
    local tema=$1 rgbs=$2 arquivo="$HOME/.config/gtk-3.0/cores-tema.css" txt
    {
        echo "/* Gerado pelo hypr-tema (tema $tema). Importado no gtk-3.0/gtk.css. Doc 25. */"
        echo "@define-color theme_selected_bg_color #$DEST;"
        echo "@define-color theme_unfocused_selected_bg_color #$DEST;"
        echo "@define-color theme_selected_fg_color #$DEST_FG;"
        # O Adwaita do GTK3 pinta seleção e foco com o azul DELE (embutido); estas regras trocam pela nossa cor
        echo "*:selected, *:selected:focus, row:selected, .view:selected, .view:selected:focus, iconview:selected,"
        echo "treeview.view:selected, placessidebar row:selected { background-color: #$DEST; color: #$DEST_FG; }"
        echo "row:selected label, row:selected image, .view:selected label { color: #$DEST_FG; }"
        echo "selection, entry selection, textview text selection, .view selection { background-color: #$DEST; color: #$DEST_FG; }"
        echo "entry:focus { border-color: #$DEST; box-shadow: inset 0 0 0 1px #$DEST, 0 0 0 2px $HALO; }"
        echo "rubberband, .rubberband { border: 1px solid #$DEST; background-color: alpha(#$DEST, 0.15); }"
        if [ "$COR_SINC" = 1 ]; then
            # fundo de VIDRO FOSCO ("carbono"): semitransparente + o desfoque do Hyprland atrás. O texto
            # continua 100% nítido (só o fundo é translúcido). Sem foco, o Hyprland deixa mais transparente (doc 44).
            echo "@define-color theme_bg_color rgba($rgbs, $COR_ALFA);"
            echo "@define-color theme_unfocused_bg_color rgba($rgbs, $COR_ALFA);"
            echo "@define-color theme_base_color rgba($rgbs, 0.55);"
            echo "@define-color theme_unfocused_base_color rgba($rgbs, 0.55);"
            echo "window.background, .background { background-color: @theme_bg_color; }"
            # barra de título SÓLIDA (janela em foco nunca transparente, doc 44); lateral transparente sobre o fundo sólido
            echo "headerbar, .titlebar { background-color: @theme_bg_color; }"
            echo ".sidebar, placessidebar, placessidebar list { background: transparent; }"
        fi
    } > "$ESTADO/gtk3.tmp"
    IFS= read -r -d '' txt < "$ESTADO/gtk3.tmp"
    gravar "$arquivo" "$txt"
}

gerar_cores() {
    local tema=$1 hex texto hover rgbs ah
    if [ "$tema" = escuro ]; then hex=$COR_ESCURA; texto=f0f0f0; hover="rgba(255, 255, 255, 0.10)"
    else hex=$COR_CLARA; texto=1e1e1e; hover="rgba(0, 0, 0, 0.07)"; fi
    rgb "$hex"; rgbs=$REPLY; alfa_hex "$COR_ALFA"; ah=$REPLY
    local txt fonte; [ "$tema" = escuro ] && fonte=ESCURA || fonte=CLARA

    # Cor de destaque EM USO (globais, usadas abaixo e no gerar_gtk3). "mono" = a cor do próprio tema:
    #   escuro: quase branco, texto escuro por cima, SOMBRA preta em volta das linhas
    #   claro:  quase preto, texto claro por cima, BRILHO branco em volta das linhas
    if [ "$COR_DESTAQUE" = mono ]; then
        if [ "$tema" = escuro ]; then DEST=f0f0f0; DEST_FG=1e1e1e; HALO="rgba(0,0,0,0.55)"
        else DEST=1e1e1e; DEST_FG=f6f6f6; HALO="rgba(255,255,255,0.80)"; fi
    else
        DEST=$COR_DESTAQUE; HALO="rgba(0,0,0,0)"
        # texto por cima do destaque: escuro se a cor é clara (amarelo, pastel...), branco se é escura
        if [ $(( 299 * 16#${DEST:0:2} + 587 * 16#${DEST:2:2} + 114 * 16#${DEST:4:2} )) -gt 165000 ]; then
            DEST_FG=1e1e1e; else DEST_FG=ffffff; fi
    fi
    echo "$DEST" > "$ESTADO/destaque"          # o print-area lê daqui a cor da linha de seleção

    # 1) Barra de cima (waybar): sempre a cor escolhida. É ela a referência.
    IFS= read -r -d '' txt <<EOF
/* Gerado pelo hypr-tema a partir de COR_$fonte e BAR_ALPHA (painel.conf). */
@define-color fundo rgba($rgbs, $BAR_ALPHA);
@define-color fundo-solido #$hex;
@define-color texto #$texto;
@define-color destaque #$DEST;
@define-color destaque-texto #$DEST_FG;
@define-color hover $hover;
EOF
    gravar "$HOME/.config/waybar/cores-$tema.css" "$txt"

    # 2) Barras de título (hyprbars) e 3) apps GTK4: a cor da barra se sincronizado; senão, o padrão
    local barra textoh
    if [ "$COR_SINC" = 1 ]; then
        barra="rgba(${hex}${ah})"
        IFS= read -r -d '' txt <<EOF
/* Gerado pelo hypr-tema: apps GTK4/libadwaita com a MESMA cor da barra de cima (COR_SINC=1), em VIDRO
   FOSCO: fundo semitransparente + desfoque do Hyprland ("carbono"); texto sempre nítido (doc 44).
   As --variáveis são as cores com nome do libadwaita: trocando aqui, muda em todos os apps. */
:root {
    --window-bg-color: rgba($rgbs, $COR_ALFA);
    --headerbar-bg-color: rgba($rgbs, $COR_ALFA);
    --headerbar-backdrop-color: rgba($rgbs, $COR_ALFA);
    --sidebar-bg-color: rgba($rgbs, $COR_ALFA);
    --sidebar-backdrop-color: rgba($rgbs, $COR_ALFA);
    --dialog-bg-color: rgb($rgbs);   /* SÓLIDO: janelinhas DENTRO de um app não têm desfoque atrás (doc 37) */
    --popover-bg-color: rgb($rgbs);   /* SÓLIDO: popups sem desfoque + transparência = texto "fantasma" de trás (doc 35) */
}
/* Janelinhas DENTRO de um app (Adw.Dialog): o "sheet" delas usa a cor de JANELA (com transparência),
   e dentro do app não existe desfoque: a página de trás aparecia por baixo. Sólidas (doc 37). */
floating-sheet > sheet, bottom-sheet > sheet { background-color: var(--dialog-bg-color); }
/* Cor de destaque (Settings → Appearance → Accent color) */
:root { --accent-bg-color: #$DEST; --accent-color: #$DEST; --accent-fg-color: #$DEST_FG; }
/* Interruptor ligado: a bolinha na cor do TEXTO do destaque (no "mono" o fundo é branco/preto e a
   bolinha branca sumiria). Campos em foco: contorno do destaque + halo de contraste (doc 42). */
switch:checked > slider { background-color: var(--accent-fg-color); }
entry:focus-within, spinbutton:focus-within { box-shadow: 0 0 0 1px var(--accent-color), 0 0 0 3px $HALO; }
EOF
    else
        [ "$tema" = escuro ] && barra="rgba(242424e6)" || barra="rgba(f2f2f2e6)"
        printf -v txt '%s\n' "/* COR_SINC=0: apps GTK4 com as cores padrão do tema (só a cor de destaque é nossa). */" \
            ":root { --accent-bg-color: #$DEST; --accent-color: #$DEST; --accent-fg-color: #$DEST_FG; }"
    fi
    # 3a) Visual Solid: por cima, o Material dos apps GTK4 (superfícies tonais, sem contornos, pílulas)
    if [ "${VISUAL:-}" = Solid ]; then
        # (o solido_cores já gerou este CSS na mesma chamada do Python que leu a paleta)
        local extra=""
        [ -f "$ESTADO/solido-gtk.css" ] && IFS= read -r -d '' extra < "$ESTADO/solido-gtk.css"
        txt+=$extra
    fi
    gravar "$HOME/.config/gtk-4.0/cores-tema.css" "$txt"
    # 3b) Apps GTK3 (Thunar, pavucontrol...): mesmas cores, pelo jeito antigo do GTK3 (@define-color)
    gerar_gtk3 "$tema" "$rgbs"
    [ "$tema" = escuro ] && textoh="rgba(ffffffdd)" || textoh="rgba(1e1e1edd)"
    local destaque kitty_barra
    [ "$tema" = escuro ] && kitty_barra="rgba(1e1e1eff)" || kitty_barra="rgba(f6f6f6ff)"   # = "background" do kitty
    if [ "$COR_DESTAQUE" = mono ]; then
        [ "$tema" = escuro ] && destaque="rgba(3a3a3aff)" || destaque="rgba(d4d4d4ff)"
    else
        [ "$tema" = escuro ] && destaque="rgba(1c2a3ce6)" || destaque="rgba(dce8f8e6)"
    fi
    # Botões da barra de título: SÍMBOLOS monocromáticos na cor do texto (doc 42), em vez de bolinhas
    #   fonte Aero Symbols (doc 49): U+F8F0 fechar · U+F8F1 maximizar/restaurar · U+F8F2 minimizar · U+F8F3 sempre visível
    #   (os 4 com a mesma caixa e centralizados na linha; tamanho 22 = fonte de 13,6 px)
    local icone; [ "$tema" = escuro ] && icone="rgba(f0f0f0ff)" || icone="rgba(1e1e1eff)"
    local B="$HOME/.local/bin/hypr-barra"
    # O Hyprland só conhece as fontes que existiam quando ELE começou. Se a Aero Symbols é mais nova que
    # este Hyprland, ela apareceria como quadradinhos: usa os símbolos comuns até o próximo login (doc 49).
    local s_fechar s_max s_min s_vis tam fonte_sym="$HOME/.local/share/fonts/AeroSymbols.ttf" hpid
    hpid=""
    read -r hpid < "${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr/$HYPRLAND_INSTANCE_SIGNATURE/hyprland.lock" 2>/dev/null
    [ -n "$hpid" ] || hpid=$(pgrep -xo Hyprland || pgrep -xo hyprland)
    if [ -f "$fonte_sym" ] && [ -n "$hpid" ] && [ "/proc/$hpid" -nt "$fonte_sym" ]; then
        s_fechar=""; s_max=""; s_min=""; s_vis=""; tam=22
    else
        s_fechar="✖"; s_max="▲"; s_min="▼"; s_vis="●"; tam=15
    fi
    IFS= read -r -d '' txt <<EOF
# Gerado pelo hypr-tema (tema $tema). Não editar: é reescrito a cada troca de tema/cor.
plugin {
    hyprbars {
        bar_color = $barra
        col.text = $textoh
        hyprbars-button = rgba(00000000), $tam, $s_fechar, $B fechar, $icone
        hyprbars-button = rgba(00000000), $tam, $s_max, $B maximizar, $icone
        hyprbars-button = rgba(00000000), $tam, $s_min, $B minimizar, $icone
        hyprbars-button = rgba(00000000), $tam, $s_vis, $B visivel, $icone
    }
}
# Terminal (kitty) e Thunar: barra SÓLIDA na cor do tema, pra barra e janela virarem uma peça só
# (semitransparente, dava pra ler o texto da janela de trás através dela)
windowrule = hyprbars:bar_color $kitty_barra, match:class ^(kitty|[Tt]hunar)$
# Janelas "sempre visível": barra de título com outro tom, pra saber que está ligado
windowrule = hyprbars:bar_color $destaque, match:tag sempre-visivel
EOF
    gravar "$HOME/.config/hypr/tema-atual.conf" "$txt"
    # Nada de "hyprctl reload" (refaz tudo e pisca): os valores AO VIVO vão por keyword, numa chamada só,
    # na fase "mostrar". Os botões (hyprbars-button) só trocam de cor no próximo login/reload.
    HYPR_LOTE="keyword plugin:hyprbars:bar_color $barra ; keyword plugin:hyprbars:col.text $textoh"

    # 4) Notificações (mako): modo padrão = escuro, modo "claro" = claro
    local fundo_escuro fundo_claro
    if [ "$COR_SINC" = 1 ]; then
        fundo_escuro="#${COR_ESCURA}${ah}"; fundo_claro="#${COR_CLARA}${ah}"
    else
        fundo_escuro="#1e1e1ecc"; fundo_claro="#f6f6f6cc"
    fi
    IFS= read -r -d '' txt <<EOF
# Gerado pelo hypr-tema (cores do tema). O modo "claro" é ativado com: "$HOME/.local/bin/hermesctl" mode -s claro
anchor=top-right
margin=12
padding=12,16
width=320
border-radius=22
border-size=0
background-color=$fundo_escuro
text-color=#f0f0f0
font=Inter 11
default-timeout=4000
# Histórico (central de notificações, doc 25): guarda as 50 últimas
max-history=50
# Clique esquerdo = abre o que a notificação oferece (ex: a conversa no Discord); direito = fecha
on-button-left=invoke-default-action
on-button-right=dismiss

# Urgentes (bateria acabando...): ficam até você fechar, com uma faixa vermelha
[urgency=critical]
default-timeout=0
border-size=2
border-color=#e01b24

# "Não perturbe": esconde tudo... menos as urgentes
[mode=dnd]
invisible=1
[mode=dnd urgency=critical]
invisible=0

[app-name=teclado]
default-timeout=1500

[mode=claro]
background-color=$fundo_claro
text-color=#1e1e1e
EOF
    MAKO_MUDOU=0; gravar "$HOME/.config/mako/config" "$txt" && MAKO_MUDOU=1
}

# A troca em DUAS fases (o aero-tema-onda --cascata chama uma de cada vez, AERO_TEMA_FASE=preparar|mostrar;
# sem fase = as duas seguidas):
#   preparar  só escreve arquivos (ninguém vê nada ainda) — roda junto com a CASCATA das peças do shell;
#   mostrar   avisa todo mundo (gsettings, Hyprland, Hermes, waybar) — roda debaixo do print parado da onda.
# ORDEM IMPORTA (doc 42): primeiro escrever TODAS as cores novas, só depois avisar os apps da troca
# (gsettings). Os apps GTK recarregam o visual no instante do aviso; antes, eles liam as cores VELHAS.
preparar_tema() {
    local tema=$1 nome escuro_ini v txt
    # Super Menu e barra: trocam o arquivo de cores (ln -sf = atalho apontando pro arquivo certo)
    # (-ef = já aponta pro mesmo arquivo: nem roda o ln)
    [ "$HOME/.config/wofi/style.css" -ef "$HOME/.config/wofi/style-$tema.css" ] ||
        ln -sfn "style-$tema.css" "$HOME/.config/wofi/style.css"
    [ "$HOME/.config/waybar/cores.css" -ef "$HOME/.config/waybar/cores-$tema.css" ] ||
        ln -sfn "cores-$tema.css" "$HOME/.config/waybar/cores.css"
    gerar_cores "$tema"
    if [ "$tema" = escuro ]; then nome=ArchAeroX16-Dark; escuro_ini=true
    else nome=ArchAeroX16; escuro_ini=false; fi
    # o mesmo nome nos arquivos que alguns programas leem em vez do gsettings (GTK2, GTK3/4 sem sessão, fastfetch...)
    for v in 3.0 4.0; do
        [ -d "$HOME/.config/gtk-$v" ] || mkdir -p "$HOME/.config/gtk-$v"
        printf -v txt '[Settings]\ngtk-theme-name=%s\ngtk-application-prefer-dark-theme=%s\n' "$nome" "$escuro_ini"
        gravar "$HOME/.config/gtk-$v/settings.ini" "$txt"
    done
    printf -v txt '# Gerado pelo hypr-tema (doc 46)\ngtk-theme-name="%s"\n' "$nome"
    gravar "$HOME/.gtkrc-2.0" "$txt"
    # o que a fase "mostrar" precisa (ela pode rodar em outro processo, depois do print da onda)
    printf 'M_TEMA=%q\nM_NOME=%q\nM_VISUAL=%q\nM_LOTE=%q\nM_MAKO=%q\nM_CORES=%q\n' "$tema" "$nome" "${VISUAL:-}" \
        "$HYPR_LOTE" "$MAKO_MUDOU" "$COR_SINC $COR_CLARA $COR_ESCURA $COR_ALFA $COR_DESTAQUE $BAR_ALPHA" \
        > "$ESTADO/mostrar"
}

mostrar_tema() {
    local M_TEMA M_NOME M_VISUAL M_LOTE M_MAKO M_CORES
    . "$ESTADO/mostrar" || return
    # Hermes (notificações): recarrega só se o config mudou; o modo claro/escuro em paralelo
    # (-a/-r = acrescentar/tirar em vez de -s: assim o "dnd" (Não perturbe) sobrevive)
    {
        [ "$M_MAKO" = 1 ] && "$HOME/.local/bin/hermesctl" reload >/dev/null 2>&1
        if [ "$M_TEMA" = claro ]; then "$HOME/.local/bin/hermesctl" mode -a claro >/dev/null 2>&1
        else "$HOME/.local/bin/hermesctl" mode -r claro >/dev/null 2>&1; fi
    } &
    hyprctl --batch "$M_LOTE" >/dev/null 2>&1 &
    pkill -SIGUSR2 -x waybar    # SIGUSR2 = "waybar, recarregue o visual"
    # Firefox (textfox): as duas paletas do sistema; claro/escuro troca sozinho, cor nova vale ao reabrir
    [ -x "$HOME/.local/bin/firefox-tema" ] && "$HOME/.local/bin/firefox-tema" >/dev/null 2>&1 &
    # Tema do sistema: ArchAeroX16 (claro) / ArchAeroX16-Dark (escuro), em ~/.local/share/themes (doc 46).
    # (color-scheme e gtk-theme são chaves independentes: em paralelo; os arquivos já estão escritos)
    if [ "$M_TEMA" = escuro ]; then gsettings set org.gnome.desktop.interface color-scheme prefer-dark &
    else gsettings set org.gnome.desktop.interface color-scheme prefer-light & fi
    # Solid: a paleta muda com o wallpaper sem mudar o nome do tema, e o GTK só relê o CSS quando o nome
    # muda. Um "pisca" de nome força a releitura (invisível: acontece debaixo da onda do aero-tema-onda).
    if [ "$M_VISUAL" = Solid ] && [ "$(gsettings get org.gnome.desktop.interface gtk-theme)" = "'$M_NOME'" ]; then
        gsettings set org.gnome.desktop.interface gtk-theme Adwaita
    fi
    gsettings set org.gnome.desktop.interface gtk-theme "$M_NOME"
    echo "$M_TEMA" > "$ESTADO/tema"
    echo "$M_CORES" > "$ESTADO/cores"
    wait
}

aplicar_tema() {
    case "${AERO_TEMA_FASE:-}" in
        preparar) preparar_tema "$1" ;;
        mostrar)  mostrar_tema ;;
        *)        preparar_tema "$1"; mostrar_tema ;;
    esac
}

# A CASCATA (solido.py): avisa as peças do shell, que trocam as próprias cores em sequência, já. Se quem
# foi clicado (Hestia...) já avisou este mesmo tema há pouco, não repete (ela já começou).
cascata_avisar() {
    local tema=$1 arq="$ESTADO/cascata" atual agora
    atual=""; [ -f "$arq" ] && IFS= read -r atual < "$arq"
    agora=${EPOCHREALTIME/,/.}
    if [[ $atual =~ \"tema\":\ *\"([a-z]+)\".*\"t0\":\ *([0-9]+) ]] && [ "${BASH_REMATCH[1]}" = "$tema" ] &&
       (( ${agora%.*} - BASH_REMATCH[2] < 5 )); then return; fi
    # no lugar, numa escrita só (rename atrasa o inotify do Gio em ~100 ms)
    printf '{"tema": "%s", "t0": %s, "origem": ""}\n' "$tema" "$agora" > "$arq"
}

aplicar_filtro() {
    local temp=$1
    # hyprsunset é o filtro de luz azul do Hyprland; precisa estar rodando pra receber comandos
    pgrep -x hyprsunset >/dev/null || { hyprctl dispatch exec hyprsunset >/dev/null; sleep 1; }
    # hyprsunset 0.4: "identity" sem valor só PERGUNTA (e responde ok) — desligar virou "identity true".
    # Desligar também volta pra 6500 K (neutro), então funciona em qualquer versão.
    if [ "$temp" = 0 ]; then
        hyprctl hyprsunset identity true >/dev/null     # cores normais
        hyprctl hyprsunset temperature 6500 >/dev/null
    else
        hyprctl hyprsunset identity false >/dev/null
        hyprctl hyprsunset temperature "$temp" >/dev/null  # menos azul (K = kelvin; menor = mais quente)
    fi
    echo "$temp" > "$ESTADO/filtro"
}

SOLIDO="$HOME/.local/share/aero-shell/solido.py"
solido_cores() {   # COR_ESCURA/COR_CLARA = surface de cada modo, destaque = primary (só na memória)
    local k v                     # uma chamada só do Python: as cores dos dois modos + o CSS GTK do modo
    while IFS='=' read -r k v; do
        [[ $v =~ ^[0-9a-f]{6}$ ]] || continue
        case "$k" in ESCURO_SURFACE) COR_ESCURA=$v ;; ESCURO_PRIMARY) DEST_ESCURO=$v ;;
                     CLARO_SURFACE) COR_CLARA=$v ;; CLARO_PRIMARY) DEST_CLARO=$v ;; esac
    done < <(python3 -I "$SOLIDO" hypr "$tema" "$ESTADO/solido-gtk.css" 2>/dev/null)
    COR_ALFA=1.0; BAR_ALPHA=1.0; COR_SINC=1
    if [ "$tema" = escuro ]; then COR_DESTAQUE=${DEST_ESCURO:-$COR_DESTAQUE}; else COR_DESTAQUE=${DEST_CLARO:-$COR_DESTAQUE}; fi
}

aplicar() {
    if [ "${AERO_TEMA_FASE:-}" = mostrar ]; then mostrar_tema; return; fi
    # Valores padrão; o painel.conf sobrescreve
    TEMA_MODO=auto; TEMA_CLARO=07:00; TEMA_ESCURO=18:00
    FILTRO_MODO=auto; FILTRO_INICIO=19:00; FILTRO_FIM=07:00; FILTRO_TEMP=4500
    COR_CLARA=f6f6f6; COR_ESCURA=1e1e1e; COR_ALFA=0.80; COR_SINC=1; COR_DESTAQUE=3584e4
    BAR_ALPHA=0.45     # taskbar only: see-through enough for Hyprland's blur behind it to show
    . "$HOME/.local/share/aero-shell/painel.sh" && ler_painel   # lê sem executar (painel.sh)
    # Cores do wallpaper ligadas: o DESTAQUE também vem dele (cores-do-wallpaper grava COR_DESTAQUE_WALL);
    # a escolha das bolinhas (COR_DESTAQUE) fica intacta no painel.conf e volta quando desligar.
    if [ "${WALL_CORES:-0}" = 1 ] && [ -n "${COR_DESTAQUE_WALL:-}" ]; then COR_DESTAQUE=$COR_DESTAQUE_WALL; fi

    local agora tema filtro
    printf -v agora '%(%H:%M)T' -1; minutos "$agora"; agora=$REPLY
    local m1 m2

    case "$TEMA_MODO" in
        claro|escuro) tema=$TEMA_MODO ;;
        *) minutos "$TEMA_CLARO"; m1=$REPLY; minutos "$TEMA_ESCURO"; m2=$REPLY
           dentro "$agora" "$m1" "$m2" && tema=claro || tema=escuro ;;
    esac
    case "$FILTRO_MODO" in
        ligado) filtro=$FILTRO_TEMP ;;
        desligado) filtro=0 ;;
        *) minutos "$FILTRO_INICIO"; m1=$REPLY; minutos "$FILTRO_FIM"; m2=$REPLY
           dentro "$agora" "$m1" "$m2" && filtro=$FILTRO_TEMP || filtro=0 ;;
    esac

    # Visual Solid: as cores saem da PALETA TONAL (solido.py, a partir da cor do wallpaper): superfícies
    # sólidas (sem vidro: alfa 1) e destaque = a primária do esquema.
    if [ "${VISUAL:-}" = Solid ]; then solido_cores; fi

    local e_tema="" e_cores="" e_filtro=""
    [ -f "$ESTADO/tema" ] && read -r e_tema < "$ESTADO/tema"
    [ -f "$ESTADO/cores" ] && read -r e_cores < "$ESTADO/cores"
    [ -f "$ESTADO/filtro" ] && read -r e_filtro < "$ESTADO/filtro"
    if [ "$1" = --forcar ] || [ "$tema" != "$e_tema" ] ||
       [ "$COR_SINC $COR_CLARA $COR_ESCURA $COR_ALFA $COR_DESTAQUE $BAR_ALPHA" != "$e_cores" ]; then
        # a troca de cores com a onda (aero-tema-onda): roda este mesmo script por baixo de um print que
        # se desfaz numa onda. No login (--loop) e dentro de uma troca que já tem onda, troca direto.
        # Solid: a CASCATA começa já (as peças do shell trocam as cores ao vivo, uma depois da outra) e a
        # onda só cobre o que sobra (apps, Hyprland), em duas fases (aero-tema-onda --cascata).
        if [ "${VISUAL:-}" = Solid ] && [ -z "${AERO_TEMA_ONDA:-}" ] && [ -z "${SEM_ONDA:-}" ]; then
            cascata_avisar "$tema"
        fi
        if [ -z "${AERO_TEMA_ONDA:-}" ] && [ -z "${SEM_ONDA:-}" ] && [ -x "$HOME/.local/bin/aero-tema-onda" ]; then
            if [ "${VISUAL:-}" = Solid ]; then "$HOME/.local/bin/aero-tema-onda" --cascata "$0" --forcar
            else "$HOME/.local/bin/aero-tema-onda" "$0" --forcar; fi
            return
        fi
        aplicar_tema "$tema"
    fi
    # Filtro de luz azul: só quando MUDA. Reenviar a mesma temperatura reaplica a matriz de cor (CTM) na
    # placa, e na NVIDIA isso pisca a tela em PRETO — era o "apagão" ao trocar claro/escuro (a troca com
    # onda chama este script com --forcar). O --forcar só força o filtro fora da onda (login, na mão).
    if { [ "$1" = --forcar ] && [ -z "${AERO_TEMA_ONDA:-}" ]; } ||
       [ "$filtro" != "$e_filtro" ]; then aplicar_filtro "$filtro"; fi
}

# O Hyprland que me iniciou ainda está vivo?
# Cada sessão do Hyprland tem a sua pasta: $XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/
# (a "assinatura" é herdada por tudo que o Hyprland inicia). Lá, a 1ª linha do hyprland.lock é o
# PID do Hyprland: é assim que o próprio "hyprctl instances" sabe quais sessões estão vivas.
# Não basta ver se o .socket.sock existe: quando o Hyprland TRAVA (crash), a pasta e o socket
# ficam para trás. E um "hyprctl reload" não muda o PID, então recarregar a config não engana o teste.
# /proc/PID/comm = o nome do programa com esse PID (confere que o número não foi reaproveitado).
# grep -i = tanto faz maiúscula ou minúscula: digitar "hyprland" no TTY abre o mesmo programa
# (é um atalho pro Hyprland), só que aí o nome do processo fica "hyprland", tudo minúsculo.
hyprland_vivo() {
    [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ] || return 0     # iniciado fora do Hyprland: não tem o que conferir
    local pid
    pid=$(head -n1 "${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr/$HYPRLAND_INSTANCE_SIGNATURE/hyprland.lock" 2>/dev/null)
    [ -n "$pid" ] && grep -qix hyprland "/proc/$pid/comm" 2>/dev/null
}

if [ "$1" = --loop ]; then
    SEM_ONDA=1 aplicar --forcar        # no login: sem onda (a tela ainda está nascendo)
    # A cada minuto, ANTES de aplicar: se o meu Hyprland morreu (travou e você entrou de novo), saio.
    # Sem isso, esta cópia "fantasma" rodava para sempre ao lado da cópia da sessão nova, e podia
    # anotar no ~/.cache/hypr-tema uma troca (filtro, tema) que nunca chegou à sessão nova.
    # O teste vem DEPOIS do sleep de propósito: no login, o hyprland.lock só aparece uns 2 segundos
    # depois de o Hyprland iniciar os exec-once (testar logo no começo daria "morto" por engano).
    while sleep 60; do
        hyprland_vivo || exit 0
        aplicar
    done
else
    aplicar "$1"
fi
