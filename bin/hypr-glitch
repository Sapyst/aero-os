#!/usr/bin/env python3
"""hypr-glitch: efeito de glitch pixelado + ASCII ao trocar de área de trabalho.

Ouve os eventos do Hyprland (socket2). A cada troca de área (Super+N, gesto, clique na barra...)
liga por ~0,4 s um shader de tela (~/.local/share/aero-shell/glitch/*.frag) que escorrega fatias
da imagem PARA O LADO da área nova, separa as cores e desenha blocos em caracteres ASCII:
  6 quadros (60 ms cada, cada vez mais leves) · depois devolve o shader que estava antes.
Sem o uniform "time": o Hyprland exigiria desligar o damage tracking (GPU alta o tempo todo).
Desligar: TRANSICAO_GLITCH=0 no ~/.config/hypr/painel.conf (vale na hora, sem reiniciar).
"""
import os
import socket
import threading
import time

RUN = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
SIG = os.environ["HYPRLAND_INSTANCE_SIGNATURE"]
PASTA = os.path.expanduser("~/.local/share/aero-shell/glitch")
PAINEL = os.path.expanduser("~/.config/hypr/painel.conf")
FASES = tuple((str(i), i * 0.06) for i in range(6))     # 6 quadros, um a cada 60 ms
DURACAO = 0.38


def hypr(cmd):
    """Comando direto no socket do Hyprland (mais rápido que chamar o hyprctl)."""
    s = socket.socket(socket.AF_UNIX)
    try:
        s.connect(f"{RUN}/hypr/{SIG}/.socket.sock")
        s.sendall(cmd.encode())
        return s.recv(65536).decode(errors="replace")
    finally:
        s.close()


def ligado():
    try:
        for linha in open(PAINEL):
            if linha.startswith("TRANSICAO_GLITCH="):
                return linha.split("=", 1)[1].strip().strip('"') != "0"
    except OSError:
        pass
    return True


class Efeito:
    def __init__(self):
        self.geracao = 0
        self.trava = threading.Lock()
        self.anterior = None          # shader que o usuário tinha antes do efeito

    def disparar(self, lado):
        with self.trava:
            self.geracao += 1
            g = self.geracao
            if self.anterior is None:
                atual = hypr("getoption decoration:screen_shader").splitlines()[0].removeprefix("str: ").strip()
                self.anterior = "" if atual in ("", "[[EMPTY]]") or atual.startswith(PASTA) else atual
        threading.Thread(target=self.rodar, args=(g, lado), daemon=True).start()

    def rodar(self, g, lado):
        inicio = time.monotonic()
        for fase, quando in FASES:
            time.sleep(max(0.0, inicio + quando - time.monotonic()))
            if g != self.geracao:
                return                          # outra troca começou: ela assume
            hypr(f"keyword decoration:screen_shader {PASTA}/{lado}-{fase}.frag")
        time.sleep(max(0.0, inicio + DURACAO - time.monotonic()))
        with self.trava:
            if g != self.geracao:
                return
            hypr(f"keyword decoration:screen_shader {self.anterior or '[[EMPTY]]'}")
            self.anterior = None


def main():
    efeito = Efeito()
    s = socket.socket(socket.AF_UNIX)
    s.connect(f"{RUN}/hypr/{SIG}/.socket2.sock")
    atual = None
    try:
        atual = int(hypr("j/activeworkspace").split('"id":', 1)[1].split(",", 1)[0])
    except (ValueError, IndexError):
        pass
    buf = b""
    while True:
        dados = s.recv(4096)
        if not dados:
            break
        buf += dados
        *linhas, buf = buf.split(b"\n")
        for linha in linhas:
            evento, _, valor = linha.decode(errors="replace").partition(">>")
            if evento != "workspacev2":
                continue
            try:
                novo = int(valor.split(",", 1)[0])
            except ValueError:
                continue
            if novo < 0 or novo == atual:       # áreas especiais (minimizados...) não animam
                continue
            lado = "dir" if atual is None or novo > atual else "esq"
            atual = novo
            if ligado():
                efeito.disparar(lado)


if __name__ == "__main__":
    main()
