#!/usr/bin/env python3
"""
pokefetch-golpes — monta ~/.local/share/pokefetch/batalha.json: o que o widget de batalha precisa e o
catálogo do pokefetch não tem (ele guarda só os NOMES dos golpes). Roda uma vez; depois é tudo local.

Fonte: os CSVs públicos do PokeAPI (github.com/PokeAPI/pokeapi, pasta data/v2/csv). Baixa pra
~/.cache/pokefetch-csv (10 MB) se ainda não estiverem lá. Uso: pokefetch-golpes [PASTA-DOS-CSVs]

O que sai (compacto, ~400 KB):
  tipos:   {atacante: {defensor: multiplicador}}  (0, 0.5, 1, 2)
  golpes:  {id: [nome, tipo, poder, precisão(0-100 ou null = nunca erra), classe(fisico|especial), prioridade]}
  pokemon: {id: [ids dos golpes de DANO que ele aprende (nível/TM/tutor), do mais forte pro mais fraco]}
Golpes de status (sem poder) ficam de fora: a batalha simulada é só de dano, pra ficar legível.
"""
import csv
import json
import os
import sys
import urllib.request
from collections import defaultdict

SAIDA = os.path.expanduser("~/.local/share/pokefetch/batalha.json")
CSV = sys.argv[1] if len(sys.argv) > 1 else os.path.expanduser("~/.cache/pokefetch-csv")
BASE = "https://raw.githubusercontent.com/PokeAPI/pokeapi/master/data/v2/csv/"
ARQUIVOS = ["types.csv", "type_efficacy.csv", "moves.csv", "pokemon_moves.csv", "pokemon.csv"]
MAXIMO = 1025                 # Pokémon 1..1025 (os ids maiores são formas alternativas)
POR_POKEMON = 12              # quantos golpes de dano guardar por Pokémon (o widget sorteia 4 entre eles)


def garantir_csvs():
    os.makedirs(CSV, exist_ok=True)
    for nome in ARQUIVOS:
        destino = os.path.join(CSV, nome)
        if not os.path.exists(destino) or os.path.getsize(destino) == 0:
            print("baixando", nome)
            urllib.request.urlretrieve(BASE + nome, destino)


def ler(nome):
    with open(os.path.join(CSV, nome), newline="", encoding="utf-8") as f:
        return list(csv.DictReader(f))


def main():
    garantir_csvs()
    tipos = {int(t["id"]): t["identifier"] for t in ler("types.csv") if int(t["id"]) <= 18}  # 10001+ = "???"
    chart = {a: {d: 1.0 for d in tipos.values()} for a in tipos.values()}
    for e in ler("type_efficacy.csv"):
        a, d = int(e["damage_type_id"]), int(e["target_type_id"])
        if a in tipos and d in tipos:
            chart[tipos[a]][tipos[d]] = int(e["damage_factor"]) / 100
    golpes = {}
    for m in ler("moves.csv"):
        if not m["power"] or int(m["type_id"]) not in tipos or m["damage_class_id"] not in ("2", "3"):
            continue                                   # sem poder (status), tipo "???" ou classe status: fora
        nome = m["identifier"].replace("-", " ").title()
        golpes[int(m["id"])] = [nome, tipos[int(m["type_id"])], int(m["power"]),
                                int(m["accuracy"]) if m["accuracy"] else None,
                                "fisico" if m["damage_class_id"] == "2" else "especial", int(m["priority"])]
    # golpes por Pokémon: junta todas as versões (quem aprendeu um dia, sabe), só métodos nível/TM/tutor
    aprende = defaultdict(set)
    for r in ler("pokemon_moves.csv"):
        pid, mid = int(r["pokemon_id"]), int(r["move_id"])
        if pid <= MAXIMO and mid in golpes and r["pokemon_move_method_id"] in ("1", "4", "3"):
            aprende[pid].add(mid)
    pokemon = {}
    for pid in range(1, MAXIMO + 1):
        ids = sorted(aprende.get(pid, ()), key=lambda i: -golpes[i][2] * ((golpes[i][3] or 100) / 100))
        pokemon[str(pid)] = ids[:POR_POKEMON]
    usados = {i for ids in pokemon.values() for i in ids}
    saida = {"tipos": chart, "golpes": {str(i): golpes[i] for i in sorted(usados)}, "pokemon": pokemon}
    os.makedirs(os.path.dirname(SAIDA), exist_ok=True)
    with open(SAIDA + ".novo", "w") as f:
        json.dump(saida, f, separators=(",", ":"))
    os.replace(SAIDA + ".novo", SAIDA)
    sem = [p for p, ids in pokemon.items() if len(ids) < 4]
    print(f"pronto: {len(pokemon)} Pokémon, {len(usados)} golpes, {os.path.getsize(SAIDA) // 1024} KB -> {SAIDA}")
    print(f"com menos de 4 golpes de dano: {len(sem)} {sem[:10]}")


if __name__ == "__main__":
    main()
